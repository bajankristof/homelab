# Copy this file to `env.tfvars` and fill in your own values.
# `env.tfvars` is gitignored and read by `root.hcl`.

# Homelab access
homelab_ip         = "192.168.69.69" # optional, defaults to 192.168.69.69
homelab_username   = "hackerman"
homelab_password   = "secure!!!444four"
homelab_dns_servers = ["1.1.1.1", "9.9.9.9"] # optional, defaults to ["1.1.1.1", "9.9.9.9"]
tailscale_auth_key = "tskey-auth-xxxxxxxxxxxx"

# DNS and TLS
cloudflare_tld           = "example.com"
cloudflare_dns_api_token = "abcdef1234567890"

# Aether / Plex
plex_claim        = "" # optional, only for claiming a fresh Plex server (https://plex.tv/claim)
plex_token        = ""
tmdb_access_token = ""
ncore_username    = ""
ncore_password    = ""

# SMTP (used by Grafana to deliver alert notifications)
smtp_host     = "smtp.resend.com"
smtp_port     = 465
smtp_username = "resend"
smtp_password = "re_1234567890abcdef"

# IAM users
iam_users = [
  {
    username   = "john.doe"
    email      = "john.doe@example.com"
    first_name = "John"
    last_name  = "Doe"
    is_admin   = true
  },
]
